# Copy this file to .env and fill in real values.
# .env is where secrets live — never commit it, never paste these values into chat.

# --- Stripe (test-mode keys to start: https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Shipping (only needed once physical merch is added — digital tracks don't ship) ---
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
SHIP_FROM_NAME=Msanii Halisi Store
SHIP_FROM_STREET1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US

# --- App ---
FLASK_ENV=development
MH_SECRET_KEY=
HOST=127.0.0.1
PORT=8845
